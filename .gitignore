# ─────────────────────────────────────────────────────────────
# 构建产物：一律走 GitHub Release 附件，不进仓库
# ─────────────────────────────────────────────────────────────
packaging/dist/
dist/
build/
*.egg-info/
*.zip
*.tar.gz
*.tgz
*.run

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ─────────────────────────────────────────────────────────────
# 运行期配置与密钥 —— 绝不入库
#   密钥存在 %APPDATA%\nlc\secrets.json（Linux: ~/.config/nlc/secrets.json），
#   正常情况不在仓库里；这几条是防止手滑拷进来的最后一道防线。
# ─────────────────────────────────────────────────────────────
secrets.json
config.json
prompts.json
wordbank.json
!tools/_shot_cfg/config.json

# 测试 / 截图脚本的临时配置目录
.tmpcfg/
tests/_gui_smoke_cfg/
tests/_tmp*/

# ─────────────────────────────────────────────────────────────
# 编辑器 / 系统
# ─────────────────────────────────────────────────────────────
.obsidian/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
