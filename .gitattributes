# 默认：按内容自动判断，仓库内统一 LF
* text=auto eol=lf

# shell 脚本必须是 LF ——否则在 Linux 上会报 "bad interpreter: /bin/sh^M"
*.sh   text eol=lf
*.run  text eol=lf

# Windows 批处理必须是 CRLF ——cmd.exe 对 LF 结尾的 if/goto 块行为不稳
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制，别做任何转换
*.png  binary
*.ico  binary
*.zip  binary
*.gz   binary
